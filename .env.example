# --- Supabase (server-side only) -------------------------------------------
# None of these have a NEXT_PUBLIC_ prefix on purpose — they must stay on the
# server and never reach the browser bundle.
# Get them from your Supabase project: Settings → API.

# Project URL. Required.
SUPABASE_URL=https://your-project-ref.supabase.co

# Anon (public) key. Required for ADMIN SIGN-IN. The console's auth flows
# (password sign-in, token refresh, user lookup) go through this key, which is
# what Supabase's auth endpoints expect. Without it every route returns 503 and
# nobody can sign in.
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Service-role key. Required for READING DATA. Grants full admin access
# (listing users, reading every generation_log row) and bypasses RLS — this is
# exactly why the whole console sits behind the admin middleware.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Backend (optional) -----------------------------------------------------
# Express backend base URL, surfaced on the Config page and used for the health
# probe. The console works without it.
# BACKEND_URL=http://localhost:3333

# ---------------------------------------------------------------------------
# GRANTING ADMIN ACCESS
#
# The console checks `app_metadata.role === "admin"` on the signed-in Supabase
# user. `app_metadata` is writable only with the service-role key or from the
# Supabase dashboard — a user cannot grant it to themselves (unlike
# `user_metadata`, which the console deliberately ignores).
#
# Supabase dashboard:  Authentication → Users → (user) → Raw app meta data
#   { "role": "admin" }
#
# Or via SQL in the SQL editor:
#   update auth.users
#      set raw_app_meta_data = coalesce(raw_app_meta_data, '{}'::jsonb)
#                              || '{"role":"admin"}'::jsonb
#    where email = 'you@example.com';
#
# The user must sign out and back in for a role change to take effect on an
# already-issued access token (or wait for it to expire and refresh).
#
# NOTE ON DEPLOYMENT: Next.js inlines process.env values into the edge
# middleware bundle at build time. SUPABASE_URL and SUPABASE_ANON_KEY must be
# set when you run `next build`, not only when you run `next start`.
# ---------------------------------------------------------------------------
