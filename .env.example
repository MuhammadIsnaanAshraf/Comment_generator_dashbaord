# --- Supabase (server-side only) -------------------------------------------
# Used by the dashboard's /api/users route to list registered users via the
# Supabase Admin API. These have NO NEXT_PUBLIC_ prefix on purpose — they must
# stay on the server and never be exposed to the browser bundle.
# Get them from your Supabase project: Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
